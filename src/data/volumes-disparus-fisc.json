{
  "meta": {
    "dossier": "SARL LA DEMI-LUNE - Controle fiscal DDFiP Jura",
    "objet": "Volumes de boissons reputes disparus selon le verificateur, par exercice",
    "formule_verificateur": "pct_disparu = (quantites_disponibles - quantites_vendues_caisse) / quantites_disponibles",
    "convention_signe": {
      "positif": "disparu - presomption d'occultation (achete non vendu en caisse)",
      "negatif": "surconsommation - presomption d'achats sans facture (vendu sans achat identifie)"
    },
    "exercices": ["2022-2023", "2023-2024", "2024-2025"],
    "sources": {
      "p_30_31": "Synthese volumes disparus (lecture visuelle, RISQUE INVERSION COLONNES annee)",
      "annexe_6": "Tableau disponibles = achats FCBS + Intermarche + stock_initial - stock_final (p.159, 165...)",
      "annexe_7": "Reconstitution detaillee par produit (p.165-201)"
    },
    "fiabilite_valeurs": {
      "exact": "lu et auto-coherent dans la source",
      "a_verifier_inversion": "issu de p.30-31, attribution annee a confirmer",
      "approx": "ordre de grandeur, non chiffre precisement dans la source",
      "disponible_seul": "seule la quantite disponible est connue (pas de vendu/pct)",
      "non_chiffre": "source indique 'eleve' sans chiffre exact"
    },
    "unites": "disponible/vendu en bouteilles ou unites sauf mention 'cl'; pct_disparu sans unite",
    "avertissements": [
      "Les % de p.30-31 demandent une relecture croisee avec annexes 7-1/7-2/7-3 (inversion possible des colonnes annee).",
      "Un pct_disparu = 100 % signifie ZERO vente enregistree en caisse => artefact de parametrage probable (hypothese H1), pas occultation.",
      "Un pct negatif ou une vente sans achat (preuve_parametrage=true) est arithmetiquement impossible sans erreur de code caisse.",
      "Le CA total reconstitue = CA liquides x coefficient (2,94 / 3,02 / 3,10) : toute erreur sur ces volumes est amplifiee ~3,94 a 4,10 fois."
    ],
    "verdict_hypotheses": {
      "H1_parametrage_caisse": "CONFIRMEE (preuve interne : Bordeaux 2024-2025 et HC Nuits 2023-2024 vendus sans achat)",
      "H2_usage_cuisine": "ECARTEE pour Porto/Calvados/Vin jaune/Macvin (deja deduits) et Picon/Cafe/Bordeaux (aucun usage cuisine)",
      "H3_doses_sous_evaluees": "ECARTEE (impact marginal 3-6 points)",
      "H4_vol_casse": "INSUFFISANTE seule (absorbe au plus 10-15 %)"
    }
  },

